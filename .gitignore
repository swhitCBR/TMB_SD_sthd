.Rproj.user
.Rhistory
.RData
.Ruserdata

# upstream inputs are not regenerated by the pipeline (local copies only)
tmp_data/*
!tmp_data/.gitkeep

# pipeline-generated files in data/ and output/ are tracked with Git LFS
# (see .gitattributes); TMB binaries stay git-ignored

# compiled TMB templates and files generated by TMBhelp
TMB/*.dll
TMB/*.so
TMB/*.o
TMB/*_inputs.RData
TMB/*_OBJ.rds
TMB/HOR_CHP_global.R
TMB/HOR_CHP_global_pred.R
